@mode(freestanding)

# The shell's halt and panic commands: the two ways the run ends.
#
# Runtime: freestanding, shared by both boards. `make build` compiles it
# into both bare-metal images, build/shell-x86_64.elf and
# build/shell-aarch64.elf, with the self-hosted `loup build --target
# freestanding`: no operating system, runtime library, heap or exceptions.
# It runs when `make boot` (tests/boot.sh) types the sessions in
# tests/sessions/ into each image under QEMU; `make check` type-checks it
# with Stage0 through each board's entry file. tests/expected/panic-*.txt
# contain the line number of `unreachable` below: a line added above it
# means updating them.

from appinfo import (STATUS_OK);
from platform.board import (Board);
from platform.console import (puts, newline);
from cli.args import (ArgError, expectArgs);

# halt: ends the run; QEMU exits with the board's "ok" status.
pub func cmdHalt(board: Board): Result[int, ArgError] {
    expectArgs(0)?;
    puts("halting");
    newline();
    let stop = board.exit;
    stop(STATUS_OK);
    return Ok(0);
}

# There is no panic() in Loup 1.26.0; reaching `unreachable` is a panic,
# and with panic = "custom" it calls the board's @panic_handler.
func fatal(): noreturn {
    unreachable;
}

# panic: stops the machine through the panic handler.
pub func cmdPanic(): Result[int, ArgError] {
    expectArgs(0)?;
    puts("panicking on purpose");
    newline();
    fatal();
}
