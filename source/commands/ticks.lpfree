@mode(freestanding)

# The shell's ticks command: the board's free-running counter since boot.
#
# Runtime: freestanding, shared by both boards. `make build` compiles it
# into both bare-metal images, build/shell-x86_64.elf and
# build/shell-aarch64.elf, with the self-hosted `loup build --target
# freestanding`: no operating system, runtime library, heap or exceptions.
# It runs when `make boot` (tests/boot.sh) types the sessions in
# tests/sessions/ into each image under QEMU; `make check` type-checks it
# with Stage0 through each board's entry file.

from platform.board import (Board);
from platform.console import (puts, putDec, newline);
from cli.args import (ArgError, expectArgs);

# The counter's value when the shell started.
var bootTicks: uint64 = 0u64;

pub func markBoot(board: Board): void {
    let readClock = board.ticks;
    bootTicks = readClock();
}

# ticks: the board's free-running counter since the shell started.
pub func cmdTicks(board: Board): Result[int, ArgError] {
    expectArgs(0)?;
    let readClock = board.ticks;
    let elapsed = readClock() - bootTicks;
    puts("ticks: ");
    putDec(elapsed);
    puts(" ");
    puts(board.clock);
    puts(" counts since boot");
    newline();
    return Ok(0);
}
