@mode(freestanding)

# The shell's echo command, and putWord, which prints one word of the line.
#
# Runtime: freestanding, shared by both boards. `make build` compiles it
# into both bare-metal images, build/shell-x86_64.elf and
# build/shell-aarch64.elf, with the self-hosted `loup build --target
# freestanding`: no operating system, runtime library, heap or exceptions.
# It runs when `make boot` (tests/boot.sh) types the sessions in
# tests/sessions/ into each image under QEMU; `make check` type-checks it
# with Stage0 through each board's entry file.

from cli.args import (ArgError, wordCountNow, wordLength, wordByte);
from platform.console import (putByte, puts, newline);

# Prints word `w` of the current line.
pub func putWord(w: int): void {
    var i = 0;
    while (i < wordLength(w)) {
        putByte(wordByte(w, i));
        i = i + 1;
    }
}

# echo [WORD]...: the words, separated by single spaces.
pub func cmdEcho(): Result[int, ArgError] {
    var w = 1;
    while (w < wordCountNow()) {
        if (w > 1) {
            puts(" ");
        }
        putWord(w);
        w = w + 1;
    }
    newline();
    return Ok(wordCountNow() - 1);
}
