@mode(freestanding)

# The Board record: the whole interface between a board file
# (main_x86_64.lpfree, main_aarch64.lpfree) and the shared shell.
#
# Runtime: freestanding, shared by both boards. `make build` compiles it
# into both bare-metal images, build/shell-x86_64.elf and
# build/shell-aarch64.elf, with the self-hosted `loup build --target
# freestanding`: no operating system, runtime library, heap or exceptions.
# It runs when `make boot` (tests/boot.sh) types the sessions in
# tests/sessions/ into each image under QEMU; `make check` type-checks it
# with Stage0 through each board's entry file.

# What a board gives the shell: facts to print, the memory the memory
# commands may touch, and the machine operations the shell cannot do itself.
pub struct Board {
    # The --arch the image was built for.
    pub let arch: string;
    # The UART the console uses.
    pub let console: string;
    # The counter `ticks` reads, e.g. "TSC".
    pub let clock: string;
    # Addresses from memStart up to (not including) memEnd are mapped.
    pub let memStart: uint64;
    pub let memEnd: uint64;
    # Free RAM for experiments with poke and sha256.
    pub let scratch: uint64;
    # Reads the free-running counter.
    pub let ticks: func(): uint64;
    # Ends the run; QEMU exits. Does not return.
    pub let exit: func(uint8): void;
}
