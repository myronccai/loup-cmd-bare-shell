@mode(freestanding)

# The console, independent of the board. The board attaches its UART's byte
# reader and writer at boot; the rest of the shell uses these functions.

func discardByte(b: uint8): void {
}

func noByte(): uint8 {
    return 0u8;
}

var gPut: func(uint8): void = discardByte;
var gGet: func(): uint8 = noByte;

pub func attach(put: func(uint8): void, get: func(): uint8): void {
    gPut = put;
    gGet = get;
}

# Waits for the next byte from the UART.
pub func getByte(): uint8 {
    return gGet();
}

pub func putByte(b: uint8): void {
    gPut(b);
}

pub func puts(s: string): void {
    for (c in s) {
        gPut(c as uint8);
    }
}

pub func newline(): void {
    gPut(10u8);
}

# Decimal, with no buffer, so the panic handler can use it too.
pub func putDec(n: uint64): void {
    var divisor: uint64 = 1u64;
    while (n / divisor >= 10u64) {
        divisor = divisor * 10u64;
    }
    var rest = n;
    while (divisor > 0u64) {
        gPut((0x30u64 + rest / divisor) as uint8);
        rest = rest % divisor;
        divisor = divisor / 10u64;
    }
}

func hexDigit(v: uint64): uint8 {
    if (v < 10u64) {
        return (0x30u64 + v) as uint8;
    }
    return (0x57u64 + v) as uint8;
}

# Lower-case hex, no prefix, at least `width` digits (zero-padded).
pub func putHex(n: uint64, width: int): void {
    var digits = 1;
    while (digits < 16 and (n >> ((digits * 4) as uint64)) != 0u64) {
        digits = digits + 1;
    }
    if (digits < width) {
        digits = width;
    }
    var shift = (digits - 1) * 4;
    while (shift >= 0) {
        gPut(hexDigit((n >> (shift as uint64)) & 0xFu64));
        shift = shift - 4;
    }
}

# 0x-prefixed hex with no padding: 0x3f8.
pub func putAddr(n: uint64): void {
    puts("0x");
    putHex(n, 1);
}
